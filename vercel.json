{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [{ "source": "/download.html", "destination": "/#get", "permanent": true }],
  "headers": [
    {
      "source": "/_astro/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
