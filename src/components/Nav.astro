---
import { Image } from 'astro:assets';
import appIcon from '../assets/app-icon.png';
import GithubMark from './GithubMark.astro';
import { site } from '../site';
---

<header
  id="nav"
  class="sticky top-0 z-50 transition-[background,box-shadow] duration-300 data-[scrolled]:bg-bg/75 data-[scrolled]:shadow-[0_1px_0_var(--line)] data-[scrolled]:backdrop-blur-xl data-[scrolled]:backdrop-saturate-150"
>
  <nav class="mx-auto flex h-16 max-w-[1180px] items-center gap-6 px-6">
    <a href="/" class="flex items-center gap-2.5 font-display text-[16px] font-semibold tracking-[-0.01em]">
      <Image src={appIcon} alt="" width={28} height={28} densities={[2, 3]} class="size-7" loading="eager" />
      {site.name}
    </a>
    <div class="ml-4 hidden items-center gap-6 text-[14px] text-ink-2 md:flex">
      <a href="#how" class="transition-colors hover:text-ink">How it works</a>
      <a href="#features" class="transition-colors hover:text-ink">Features</a>
      <a href="#tv" class="transition-colors hover:text-ink">Watch on TV</a>
      <a href="#faq" class="transition-colors hover:text-ink">FAQ</a>
    </div>
    <div class="ml-auto flex items-center gap-2">
      <a
        href={site.github}
        class="hidden size-9 items-center justify-center rounded-full text-ink-2 transition-colors hover:bg-ink/5 hover:text-ink sm:flex"
        aria-label="Movie Monkey on GitHub"
      >
        <GithubMark size={18} />
      </a>
      {
        site.downloadUrl ? (
          <a href={site.downloadUrl} class="inline-flex h-9 items-center rounded-full bg-ink px-4 text-[13.5px] font-medium text-bg transition-transform active:scale-[0.97]">
            Download
          </a>
        ) : (
          <a href="#get" class="inline-flex h-9 items-center gap-2 rounded-full bg-ink px-4 text-[13.5px] font-medium text-bg transition-transform active:scale-[0.97]">
            <span class="size-1.5 rounded-full bg-accent" style="animation: pulse-dot 2s ease-in-out infinite" />
            Coming soon
          </a>
        )
      }
    </div>
  </nav>
</header>

<script>
  const nav = document.getElementById('nav')!;
  const onScroll = () => nav.toggleAttribute('data-scrolled', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>
