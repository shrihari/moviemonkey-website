---
// An app screenshot that follows the visitor's light/dark preference, served
// as responsive AVIF/WebP generated at build time.
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  light: ImageMetadata;
  dark?: ImageMetadata;
  alt: string;
  sizes?: string;
  loading?: 'eager' | 'lazy';
  class?: string;
  widths?: number[];
}

const {
  light,
  dark,
  alt,
  sizes = '(min-width: 1200px) 1120px, 94vw',
  loading = 'lazy',
  class: cls,
  widths = [640, 960, 1280, 1680, 2240, 2880],
} = Astro.props;

async function srcset(img: ImageMetadata, format: 'avif' | 'webp') {
  const ws = widths.filter((w) => w <= img.width);
  const out = await Promise.all(ws.map((width) => getImage({ src: img, width, format, quality: format === 'avif' ? 62 : 80 })));
  return out.map((o, i) => `${o.src} ${ws[i]}w`).join(', ');
}

const lightAvif = await srcset(light, 'avif');
const lightWebp = await srcset(light, 'webp');
const darkAvif = dark ? await srcset(dark, 'avif') : null;
const darkWebp = dark ? await srcset(dark, 'webp') : null;
const fallback = await getImage({ src: light, width: 1680, format: 'webp', quality: 80 });
---

<picture>
  {darkAvif && <source media="(prefers-color-scheme: dark)" type="image/avif" srcset={darkAvif} sizes={sizes} />}
  {darkWebp && <source media="(prefers-color-scheme: dark)" type="image/webp" srcset={darkWebp} sizes={sizes} />}
  <source type="image/avif" srcset={lightAvif} sizes={sizes} />
  <source type="image/webp" srcset={lightWebp} sizes={sizes} />
  <img
    src={fallback.src}
    alt={alt}
    width={light.width / 2}
    height={light.height / 2}
    loading={loading}
    fetchpriority={loading === 'eager' ? 'high' : 'auto'}
    decoding="async"
    class:list={['block h-auto w-full', cls]}
  />
</picture>
